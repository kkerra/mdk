using System;
using System.Collections.Generic;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;

namespace SimpleTextEditorWPF
{
    public partial class SettingsWindow : Window
    {
        public string SelectedFontFamily { get; set; }
        public double SelectedFontSize { get; set; }
        public MainWindow.ColorScheme SelectedColorScheme { get; set; }

        public SettingsWindow(string currentFontFamily, double currentFontSize, MainWindow.ColorScheme currentColorScheme)
        {
            InitializeComponent();

            // Заполняем список шрифтов
            foreach (FontFamily fontFamily in Fonts.SystemFontFamilies)
            {
                fontFamilyComboBox.Items.Add(fontFamily.Source);
            }

            // Заполняем список размеров шрифта
            List<double> fontSizes = new List<double> { 8, 9, 10, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72 };
            foreach (double fontSize in fontSizes)
            {
                fontSizeComboBox.Items.Add(fontSize);
            }

            // Устанавливаем выбранные значения
            SelectedFontFamily = currentFontFamily;
            SelectedFontSize = currentFontSize;
            SelectedColorScheme = currentColorScheme;

            fontFamilyComboBox.SelectedItem = SelectedFontFamily;
            fontSizeComboBox.SelectedItem = SelectedFontSize;
            colorSchemeComboBox.SelectedItem = SelectedColorScheme.ToString(); // Преобразуем enum в строку для отображения
        }

        private void OkButton_Click(object sender, RoutedEventArgs e)
        {
            SelectedFontFamily = fontFamilyComboBox.SelectedItem as string;
            SelectedFontSize = (double)fontSizeComboBox.SelectedItem;
            if (Enum.TryParse(colorSchemeComboBox.SelectedItem?.ToString(), out MainWindow.ColorScheme colorScheme))
            {
                SelectedColorScheme = colorScheme;
            }
            else
            {
                MessageBox.Show("Неверная цветовая схема.", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
                return; // Прерываем сохранение, если схема неверная
            }

            DialogResult = true;
            Close();
        }

        private void CancelButton_Click(object sender, RoutedEventArgs e)
        {
            DialogResult = false;
            Close();
        }
    }
}


