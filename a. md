        private void SettingsMenuItem_Click(object sender, RoutedEventArgs e)
        {
            SettingsWindow settingsWindow = new SettingsWindow(selectedFontFamily, selectedFontSize, currentColorScheme, customBackgroundColor, customForegroundColor);
            if (settingsWindow.ShowDialog() == true)
            {
                selectedFontFamily = settingsWindow.SelectedFontFamily;
                selectedFontSize = settingsWindow.SelectedFontSize;
                currentColorScheme = settingsWindow.SelectedColorScheme;
                customBackgroundColor = settingsWindow.CustomBackgroundColor;
