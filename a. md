                ApplySettings();
                SaveSettings(); //Сохраняем настройки при закрытии окна настроек
            }
        }


        private void ApplySettings()
        {
            // Шрифт и размер текста
            textBox.FontFamily = new FontFamily(selectedFontFamily);
            textBox.FontSize = selectedFontSize;

            // Цветовая схема
            switch (currentColorScheme)
            {
                case ColorScheme.Day:
                    textBox.Background = Brushes.White;
                    textBox.Foreground = Brushes.Black;
                    break;
                case ColorScheme.Night:
                    textBox.Background = Brushes.Black;
                    textBox.Foreground = Brushes.LightGray;
                    break;
                case ColorScheme.Custom:
                    textBox.Background = new SolidColorBrush(customBackgroundColor);
                    textBox.Foreground = new SolidColorBrush(customForegroundColor);
                    break;
            }
        }

        private void SaveSettings()
        {
            // Сохраняем настройки в конфигурационном файле
            Properties.Settings.Default.FontFamily = selectedFontFamily;
            Properties.Settings.Default.FontSize = selectedFontSize;
            Properties.Settings.Default.ColorScheme = currentColorScheme.ToString();
            Properties.Settings.Default.CustomBackgroundColor = ColorConverter.ConvertToString(customBackgroundColor);
            Properties.Settings.Default.CustomForegroundColor = ColorConverter.ConvertToString(customForegroundColor);
            Properties.Settings.Default.Save();
        }

        private void LoadSettings()
        {
            // Загружаем настройки из конфигурационного файла
            selectedFontFamily = Properties.Settings.Default.FontFamily;
            selectedFontSize = Properties.Settings.Default.FontSize;

            // Обработка случая, если сохраненное значение не соответствует ни одному из значений перечисления
            if (Enum.TryParse(Properties.Settings.Default.ColorScheme, out ColorScheme scheme))
            {
                currentColorScheme = scheme;
            }
            else
            {
                currentColorScheme = ColorScheme.Day; // Значение по умолчанию
            }


            try
            {
                customBackgroundColor = (Color)ColorConverter.ConvertFromString(Properties.Settings.Default.CustomBackgroundColor);
                customForegroundColor = (Color)ColorConverter.ConvertFromString(Properties.Settings.Default.CustomForegroundColor);

            }
            catch (Exception)
            {
                 // Если произошла ошибка при загрузке пользовательских цветов, устанавливаем значения по умолчанию.
                customBackgroundColor = Colors.White;
                customForegroundColor = Colors.Black;
            }
        }

        private void OpenLastEditedFile()
        {
            string lastFilePath = Properties.Settings.Default.LastEditedFile;
            if (!string.IsNullOrEmpty(lastFilePath))
            {
                if (File.Exists(lastFilePath))
                {
                    currentFilePath = lastFilePath;
                    try
                    {
                        textBox.Text = File.ReadAllText(currentFilePath);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show("Ошибка при открытии последнего файла: " + ex.Message, "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
                        currentFilePath = ""; // Сброс пути, если произошла ошибка
                    }
                }
                else
                {
                    // Если файл не существует, создаем новый
                    CreateNewFile();
                }
            }
            else
            {
                // Если нет сохраненного файла, создаем новый
                CreateNewFile();
            }
        }

        private void SaveLastEditedFile(string filePath)
        {
            // Сохраняем путь к последнему открытому файлу
            Properties.Settings.Default.LastEditedFile = filePath;
            Properties.Settings.Default.Save();
        }

        private void CreateNewFile()
        {
            textBox.Clear();
            currentFilePath = "";
            SaveLastEditedFile(""); // Очищаем запись о последнем файле
        }


         private void AboutMenuItem_Click(object sender, RoutedEventArgs e)
        {
            string version = GetAppVersion();
            string description = GetAppDescription();

            MessageBox.Show($"Версия: {version}\nОписание: {description}", "О приложении", MessageBoxButton.OK, MessageBoxImage.Information);
        }

        private string GetAppVersion()
        {
             try
            {
                string subkey = "SOFTWARE\\MyApplication"; // Замените на ваш путь
                using (RegistryKey key = Registry.CurrentUser.OpenSubKey(subkey))
                {
                    if (key != null)
                    {
                        object versionValue = key.GetValue("Version");
                        if (versionValue != null)
                        {
                            return versionValue.ToString();
                        }
                    }
                    return "Версия не найдена"; // Если версия не найдена в реестре
                }
            }
            catch (Exception)
            {
                return "Версия не найдена (ошибка чтения реестра)";
            }
        }

        private string GetAppDescription()
        {
             try
            {
                string subkey = "SOFTWARE\\MyApplication"; // Замените на ваш путь
                using (RegistryKey key = Registry.CurrentUser.OpenSubKey(subkey))
                {
                    if (key != null)
                    {
                        object descriptionValue = key.GetValue("Description");
                        if (descriptionValue != null)
                        {
                            return descriptionValue.ToString();
                        }
                    }
                    return "Описание не найдено"; // Если описание не найдено в реестре
                }
            }
            catch (Exception)
            {
                return "Описание не найдено (ошибка чтения реестра)";
            }
        }
    }
